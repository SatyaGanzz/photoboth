# PHOTOBOOTH STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env untuk mengaktifkan pengaturan kustom

# Port Server
PORT=5000

# Operator / Admin Credentials
ADMIN_USERNAME=Sxatya
ADMIN_PASSWORD=R13245

# Allowed CORS Origin (default * untuk pengembangan)
ALLOWED_ORIGIN=*

# Hardware Camera Mode (auto | browser | dslr | simulator)
CAMERA_MODE=auto

# Hardware Printer Mode (mock | system | dnp)
PRINTER_MODE=mock

# Google Drive Integration (Opsional - Kosongkan jika belum ada akun Google Service)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
